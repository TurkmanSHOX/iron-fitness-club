# IRON FITNESS CLUB - MUHIT O'ZGARUVCHILARI (ENVIRONMENT CONFIG)

# Flask ilova xavfsizlik kaliti
SECRET_KEY=iron-fitness-super-secret-key-2026-production

# Ma'lumotlar bazasi ulanishi (MariaDB / HeidiSQL)
# MariaDB serveri uchun:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/iron_fitness_club?charset=utf8mb4

# Lokal sinov uchun (agar MariaDB o'rnatilmagan bo'lsa, avtomatik SQLite ga o'tadi):
# DATABASE_URL=sqlite:///instance/iron_fitness.db

# Vaqt mintaqasi
TIMEZONE=Asia/Tashkent

# Telegram Bot sozlamalari (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=7891234567:AAExampleTelegramBotTokenHere
TELEGRAM_BOT_USERNAME=iron_fitness_club_bot
ADMIN_TELEGRAM_ID=123456789

# Click to'lov tizimi rasmiy API ma'lumotlari (Click Merchant kabinetidan olinadi)
CLICK_MERCHANT_ID=12345
CLICK_SERVICE_ID=67890
CLICK_SECRET_KEY=your_click_secret_key_here

# Payme to'lov tizimi rasmiy API ma'lumotlari (Payme Business kabinetidan olinadi)
PAYME_MERCHANT_ID=64a1234567890abcdef12345
PAYME_SECRET_KEY=your_payme_secret_key_here
PAYME_TEST_MODE=true

# Server sozlamalari
PORT=5000
HOST=0.0.0.0
DEBUG=True
