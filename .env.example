# IRON FITNESS CLUB - MUHIT O'ZGARUVCHILARI (ENVIRONMENT CONFIG)

# Ishlash muhiti (production / development)
FLASK_ENV=production

# Flask ilova maxfiy kaliti (Ishga tushirishdan oldin murakkab ixtiyoriy 64-belgili satrga almashtiring)
SECRET_KEY=generate_a_very_strong_random_secret_key_here_for_production_2026

# Ma'lumotlar bazasi ulanishi: MariaDB (HeidiSQL mos)
# Production rejimida MariaDB serveri ishlab turishi SHART!
DATABASE_URL=mysql+pymysql://db_user:db_password@localhost:3306/iron_fitness_club?charset=utf8mb4

# Vaqt mintaqasi (O'zbekiston standart vaqti)
TIMEZONE=Asia/Tashkent

# Cookie xavfsizligi (HTTPS ostida True qilinadi)
SESSION_COOKIE_SECURE=false

# Telegram Bot sozlamalari (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=your_real_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=iron_fitness_club_bot
ADMIN_TELEGRAM_ID=your_personal_telegram_numeric_id

# Click to'lov tizimi rasmiy API ma'lumotlari (Click Merchant kabinetidan olinadi)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payme to'lov tizimi rasmiy API ma'lumotlari (Payme Business kabinetidan olinadi)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=false

# Server sozlamalari
PORT=5000
HOST=0.0.0.0
WSGI_THREADS=8
